{
  "expo": {
    "name": "FitTracker Pro",
    "slug": "fittrackerapp",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./flex.jpeg",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./flex.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#2d1f3d"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nioki50.fittracker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./flex.jpeg",
        "backgroundColor": "#2d1f3d"
      },
      "package": "com.nioki50.fittracker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/a410c4b3-3d26-4a76-94fb-fd33abe9691f"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "a410c4b3-3d26-4a76-94fb-fd33abe9691f"
      }
    },
    "owner": "nioky50",
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
